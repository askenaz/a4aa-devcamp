# Copia este archivo a demo-app/.env y completa las tres variables de Auth0.
# .env contiene credenciales reales y está excluido de Git.
# AUTH0_DOMAIN es el dominio del tenant sin https:// ni barra final.
# Ejemplo: mi-tenant.us.auth0.com
AUTH0_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Pulsa "Provision Resources" en la app para crear las APIs, la SPA,
# el cliente CIBA, los usuarios y la conexión CRM. El resultado se guarda
# automáticamente en .env; no copies aquí credenciales generadas por Auth0.

# El cliente OBO se registra manualmente en Auth0 (módulo 02).
# AUTH0_OBO_CLIENT_ID=
# AUTH0_OBO_CLIENT_SECRET=

# Para CIMD local, expón el servidor MCP (:3001) por HTTPS e importa
# https://tu-tunel-mcp.ngrok-free.app/.well-known/client-metadata en Auth0.
# MCP_PUBLIC_URL debe contener solo el origen público del MCP.
# MCP_PUBLIC_URL=https://tu-tunel-mcp.ngrok-free.app

# "Connect CRM" usa los endpoints públicos configurados en la conexión
# de Auth0. Si usas ngrok, expón el CRM (:3002) con otro túnel y actualiza
# authorizationURL y tokenURL en Auth0; MCP_PUBLIC_URL no controla CRM.
# CRM_API_URL=http://localhost:3002

# Opcional: modelo real. Sin OPENAI_API_KEY se usa el simulador local.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# Opcional: Okta FGA / OpenFGA real. Sin estas credenciales, los checks
# de documentos se ejecutan contra tuplas en memoria.
# FGA_API_URL=
# FGA_API_AUDIENCE=
# FGA_API_TOKEN_ISSUER=
# FGA_CLIENT_ID=
# FGA_CLIENT_SECRET=

# Puertos habituales (el script de desarrollo puede elegir otros si
# están ocupados). Descomenta solo si necesitas valores fijos.
# PORT=3000
# MCP_SERVER_PORT=3001
# THIRD_PARTY_API_PORT=3002
