@startuml
!pragma teoz true
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam sequence {
  ArrowColor #2563A6
  LifeLineBorderColor #ABBCCE
  ParticipantBorderColor #B5C8DA
  ParticipantBackgroundColor #F1F6FA
  ParticipantFontColor #142B43
  GroupBorderColor #8A9BAE
  GroupBackgroundColor #F6F8FB
}
title M2M de herramientas · PROPUESTA, NO IMPLEMENTADO
autonumber
participant "Worker externo (por implementar, sin puerto fijo)" as Worker
participant "Auth0 (HTTPS :443)" as Auth0
participant "Nexus MCP server (:3001)" as NexusMcp
participant "FGA para servicios (por implementar)" as FgaServices
Worker->Auth0: /oauth/token con client_credentials y audiencia destino
Auth0->Auth0: Comprobar grant de tipo client y scopes
Auth0-->Worker: Token con identidad del servicio
Worker->NexusMcp: Operación con Bearer de servicio
NexusMcp->NexusMcp: Validar JWT, audiencia, scopes y tipo de principal
NexusMcp->FgaServices: Autorizar el servicio sobre el recurso
FgaServices-->NexusMcp: Allow o deny
NexusMcp-->Worker: Resultado
@enduml
